rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isAdministrator() {
   return request.auth != null &&
    exists(/databases/$(database)/documents/compas_admins/$(request.auth.uid)) &&
    get(/databases/$(database)/documents/compas_admins/$(request.auth.uid)).data.active == true;
  }
  function accountEnabled(scope) {
   return !exists(/databases/$(database)/documents/compas_access_accounts/$(request.auth.uid)) ||
    (get(/databases/$(database)/documents/compas_access_accounts/$(request.auth.uid)).data.active == true &&
     (!('scope' in get(/databases/$(database)/documents/compas_access_accounts/$(request.auth.uid)).data) ||
      get(/databases/$(database)/documents/compas_access_accounts/$(request.auth.uid)).data.scope == scope));
  }
  function member(scope) {
   return isAdministrator() || (request.auth != null && accountEnabled(scope) &&
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.active == true &&
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.role in ['reader', 'coordinator', 'administrator']);
  }
  function canWriteTerritorialProposal(scope) {
   return request.auth != null && !isAdministrator() && accountEnabled(scope) &&
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.active == true &&
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.role == 'coordinator';
  }
  function canWriteScope(scope) {
   return isAdministrator() || (request.auth != null && accountEnabled(scope) &&
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.active == true &&
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.role in ['coordinator', 'administrator']);
  }
  function scopeNotWithdrawn(scope) {
   return !exists(/databases/$(database)/documents/compas_deleted_scopes/$(scope));
  }
  function validWorkspaceManifest(scope) {
   let d = request.resource.data;
   return d.keys().hasAll(['schema','municipalityId','snapshotId','chunkCount','characterLength','workspaceUpdatedAt','savedBy','savedAt']) &&
    d.keys().hasOnly(['schema','municipalityId','snapshotId','chunkCount','characterLength','workspaceUpdatedAt','savedBy','savedAt']) &&
    d.schema == 'compas-workspace-chunks/v1' && d.municipalityId == scope &&
    d.snapshotId is string && d.snapshotId.size() > 10 && d.snapshotId.size() <= 100 &&
    d.chunkCount is int && d.chunkCount > 0 && d.chunkCount <= 400 &&
    d.characterLength is int && d.characterLength >= 0 &&
    d.workspaceUpdatedAt is string && d.savedBy == request.auth.uid && d.savedAt == request.time;
  }
  function validWorkspaceChunk() {
   let d = request.resource.data;
   return d.keys().hasAll(['index','content','savedBy','savedAt']) &&
    d.keys().hasOnly(['index','content','savedBy','savedAt']) &&
    d.index is int && d.index >= 0 && d.index < 400 &&
    d.content is string && d.content.size() <= 720000 &&
    d.savedBy == request.auth.uid && d.savedAt == request.time;
  }
  function validDraft(scope, moduleId) {
   let d = request.resource.data;
   return d.keys().hasAll(['version','payload','updatedBy','updatedAt']) &&
    d.keys().hasOnly(['version','payload','updatedBy','updatedAt']) &&
    d.version is int && d.version > 0 && d.payload is map &&
    d.payload.municipalityId == scope && d.payload.moduleId == moduleId &&
    d.payload.decisions is map && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
  }
  function validReview(scope, moduleId) {
   let d = request.resource.data;
   return d.keys().hasAll(['version','payload','updatedBy','updatedAt']) &&
    d.keys().hasOnly(['version','payload','updatedBy','updatedAt']) &&
    d.version is int && d.version > 0 && d.payload is map &&
    d.payload.municipalityId == scope && d.payload.moduleId == moduleId &&
    d.payload.sourceVersion is string && d.payload.sourceDraftVersion is int && d.payload.sourceDraftVersion >= 0 &&
    d.payload.decisions is map && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
  }
  match /compas_admins/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, write: if false;
  }
  function manageable(uid) {
   return isAdministrator() && request.auth.uid != uid &&
    !exists(/databases/$(database)/documents/compas_admins/$(uid));
  }
  function validAccount(uid) {
   let d = request.resource.data;
   let membership = getAfter(/databases/$(database)/documents/relas_memberships/$(uid)/scopes/$(d.scope)).data;
   return d.keys().hasAll(['email','scope','role','active']) &&
    d.keys().hasOnly(['email','scope','role','active']) &&
    d.email is string && d.email.size() > 3 && d.email.size() <= 254 &&
    d.scope is string && d.scope.matches('^[a-z0-9][a-z0-9-]{0,79}$') &&
    d.role in ['coordinator','reader'] && d.active is bool &&
    exists(/databases/$(database)/documents/relas_scopes/$(d.scope)) &&
    membership.active == d.active && membership.role == d.role;
  }
  match /compas_access_accounts/{uid} {
   allow read: if isAdministrator();
   allow create: if manageable(uid) && validAccount(uid);
   allow update: if manageable(uid) && validAccount(uid) && request.resource.data.scope == resource.data.scope;
   allow delete: if false;
  }
  match /compas_access_audit/{id} {
   allow read: if isAdministrator();
   allow write: if false;
  }
  match /relas_memberships/{uid}/scopes/{scope} {
   allow read: if isAdministrator() || (request.auth != null && request.auth.uid == uid);
   function managedMembership() {
    let d = request.resource.data;
    let account = getAfter(/databases/$(database)/documents/compas_access_accounts/$(uid)).data;
    return d.keys().hasAll(['active','role']) && d.keys().hasOnly(['active','role']) &&
     d.active is bool && d.role in ['coordinator','reader'] &&
     account.scope == scope && account.active == d.active && account.role == d.role;
   }
   allow create, update: if manageable(uid) && managedMembership();
   allow delete: if false;
  }
  match /relas_scopes/{scope} {
   allow get: if member(scope);
   allow list: if isAdministrator();
   allow create: if isAdministrator() && scope.matches('^[a-z0-9][a-z0-9-]{0,79}$') &&
    request.resource.data.keys().hasAll(['name','type','createdBy','createdAt']) &&
    request.resource.data.keys().hasOnly(['name','type','createdBy','createdAt']) &&
    request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
    request.resource.data.type in ['municipio','mancomunidad','distrito-municipal'] &&
    request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
  match /compas_deleted_scopes/{scope} {
   allow read: if request.auth != null && (isAdministrator() ||
    get(/databases/$(database)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data.active == true);
   allow list: if isAdministrator();
   allow create, delete: if isAdministrator() && scope.matches('^[a-z0-9][a-z0-9-]{0,79}$');
   allow update: if false;
  }
  // Índice documental por huella, inmutable y segregado por ámbito.
  match /relas_scopes/{scope}/originals/{sha256} {
   allow get, list: if member(scope);
   allow create: if canWriteScope(scope) &&
    sha256.matches('^[0-9a-f]{64}
   allow read: if member(scope);
   allow create, update: if canWriteScope(scope) && scopeNotWithdrawn(scope) && validWorkspaceManifest(scope);
   allow delete: if isAdministrator();
  }
  match /relas_scopes/{scope}/workspace_versions/{snapshotId}/chunks/{chunkId} {
   allow read: if member(scope);
   allow create, update: if canWriteScope(scope) && scopeNotWithdrawn(scope) && validWorkspaceChunk();
   allow delete: if false;
  }
  match /relas_scopes/{scope}/drafts/{moduleId} {
   allow read: if member(scope);
   function hasHistory() {
    return getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/drafts/$(moduleId)/history/$(string(request.resource.data.version))).data == request.resource.data;
   }
   allow create: if canWriteTerritorialProposal(scope) && validDraft(scope,moduleId) && request.resource.data.version == 1 && hasHistory();
   allow update: if canWriteTerritorialProposal(scope) && validDraft(scope,moduleId) && request.resource.data.version == resource.data.version + 1 && hasHistory();
   allow delete: if false;
   match /history/{version} {
    allow read: if member(scope);
    allow create: if canWriteTerritorialProposal(scope) && validDraft(scope,moduleId) && version == string(request.resource.data.version) &&
     getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/drafts/$(moduleId)).data == request.resource.data;
    allow update, delete: if false;
   }
  }
  match /relas_scopes/{scope}/reviews/{moduleId} {
   allow read: if member(scope);
   function hasHistory() {
    return getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/reviews/$(moduleId)/history/$(string(request.resource.data.version))).data == request.resource.data;
   }
   allow create: if isAdministrator() && validReview(scope,moduleId) && request.resource.data.version == 1 && hasHistory();
   allow update: if isAdministrator() && validReview(scope,moduleId) && request.resource.data.version == resource.data.version + 1 && hasHistory();
   allow delete: if false;
   match /history/{version} {
    allow read: if member(scope);
    allow create: if isAdministrator() && validReview(scope,moduleId) && version == string(request.resource.data.version) &&
     getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/reviews/$(moduleId)).data == request.resource.data;
    allow update, delete: if false;
   }
  }
 }
}
) &&
    request.resource.data.keys().hasAll(['schema','municipalityId','sha256','storagePath','byteLength','fileName','contentType','createdBy','createdAt']) &&
    request.resource.data.keys().hasOnly(['schema','municipalityId','sha256','storagePath','byteLength','fileName','contentType','createdBy','createdAt']) &&
    request.resource.data.schema == 'compas-original/v1' &&
    request.resource.data.municipalityId == scope &&
    request.resource.data.sha256 == sha256 &&
    request.resource.data.storagePath == 'relas_scopes/' + scope + '/originals/' + sha256 &&
    request.resource.data.byteLength is int && request.resource.data.byteLength > 0 && request.resource.data.byteLength <= 41943040 &&
    request.resource.data.fileName is string && request.resource.data.fileName.size() > 0 && request.resource.data.fileName.size() <= 255 &&
    request.resource.data.contentType is string && request.resource.data.contentType.size() > 0 && request.resource.data.contentType.size() <= 120 &&
    request.resource.data.createdBy == request.auth.uid &&
    request.resource.data.createdAt == request.time;
   allow update, delete: if false;
  }
  match /relas_scopes/{scope}/workspace/current {
   allow read: if member(scope);
   allow create, update: if canWriteScope(scope) && validWorkspaceManifest(scope);
   allow delete: if false;
  }
  match /relas_scopes/{scope}/workspace_versions/{snapshotId}/chunks/{chunkId} {
   allow read: if member(scope);
   allow create, update: if canWriteScope(scope) && validWorkspaceChunk();
   allow delete: if canWriteScope(scope);
  }
  match /relas_scopes/{scope}/drafts/{moduleId} {
   allow read: if member(scope);
   function hasHistory() {
    return getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/drafts/$(moduleId)/history/$(string(request.resource.data.version))).data == request.resource.data;
   }
   allow create: if canWriteTerritorialProposal(scope) && validDraft(scope,moduleId) && request.resource.data.version == 1 && hasHistory();
   allow update: if canWriteTerritorialProposal(scope) && validDraft(scope,moduleId) && request.resource.data.version == resource.data.version + 1 && hasHistory();
   allow delete: if false;
   match /history/{version} {
    allow read: if member(scope);
    allow create: if canWriteTerritorialProposal(scope) && validDraft(scope,moduleId) && version == string(request.resource.data.version) &&
     getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/drafts/$(moduleId)).data == request.resource.data;
    allow update, delete: if false;
   }
  }
  match /relas_scopes/{scope}/reviews/{moduleId} {
   allow read: if member(scope);
   function hasHistory() {
    return getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/reviews/$(moduleId)/history/$(string(request.resource.data.version))).data == request.resource.data;
   }
   allow create: if isAdministrator() && validReview(scope,moduleId) && request.resource.data.version == 1 && hasHistory();
   allow update: if isAdministrator() && validReview(scope,moduleId) && request.resource.data.version == resource.data.version + 1 && hasHistory();
   allow delete: if false;
   match /history/{version} {
    allow read: if member(scope);
    allow create: if isAdministrator() && validReview(scope,moduleId) && version == string(request.resource.data.version) &&
     getAfter(/databases/$(database)/documents/relas_scopes/$(scope)/reviews/$(moduleId)).data == request.resource.data;
    allow update, delete: if false;
   }
  }
 }
}
