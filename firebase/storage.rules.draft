rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pre-deployment draft. Two Firestore reads maximum: membership + access account.
    // The superadministrator bypass is deliberately NOT implemented here.
    function eligible(scope, writable) {
      let membership = firestore.get(/databases/(default)/documents/relas_memberships/$(request.auth.uid)/scopes/$(scope)).data;
      let account = firestore.get(/databases/(default)/documents/compas_access_accounts/$(request.auth.uid)).data;
      return membership.active == true &&
        membership.role in (writable ? ['coordinator','administrator'] : ['reader','coordinator','administrator']) &&
        account.active == true && account.scope == scope;
    }
    match /relas_scopes/{scope}/originals/{hash} {
      allow get: if request.auth != null && eligible(scope, false);
      allow list: if false;
      allow create: if request.auth != null && eligible(scope, true) &&
        hash.matches('^[0-9a-f]{64}$') &&
        request.resource.size > 0 && request.resource.size <= 40 * 1024 * 1024 &&
        request.resource.metadata.sha256 == hash &&
        request.resource.metadata.municipalityId == scope;
      allow update, delete: if false;
    }
  }
}
